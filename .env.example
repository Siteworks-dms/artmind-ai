# ── FRONTEND (Vite — safe to expose in browser) ──────────────
# Get from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ── BACKEND (Vercel env vars only — NEVER commit these) ───────
# These are used by /api/*.js serverless functions only

# Supabase service role key (bypasses RLS — keep secret!)
# Get from: supabase.com → Settings → API → service_role key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# AI provider keys
# Get from: platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Get from: platform.stability.ai/account/keys
STABILITY_API_KEY=sk-...

# Get from: huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...
